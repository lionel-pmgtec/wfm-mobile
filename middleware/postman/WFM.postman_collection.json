{
  "info": {
    "name": "WFM Middleware (Cruscotto)",
    "description": "Collection per pilotare il middleware WFM come Cruscotto: creare Avvisi e ODL, aggiornarne lo stato, inviare esiti e consultare le anagrafiche. Tutti i dati creati vengono persistiti nel file Excel wfm-database.xlsx. Impostare l'environment 'WFM Middleware — Local' (variabile {{baseUrl}}).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.token) { pm.environment.set('token', json.token); }",
                  "pm.test('login ok', () => pm.response.code === 200);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "sap-client", "value": "{{sapClient}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cid\": \"{{cid}}\",\n  \"password\": \"test\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Work Orders (ODL)",
      "item": [
        {
          "name": "List work-orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/work-orders?status=&q=&date=",
              "host": ["{{baseUrl}}"],
              "path": ["work-orders"],
              "query": [
                { "key": "status", "value": "" },
                { "key": "q", "value": "" },
                { "key": "date", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Get work-order detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/work-orders/{{lastWorkOrderCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["work-orders", "{{lastWorkOrderCode}}"]
            }
          }
        },
        {
          "name": "Create work-order (ODL)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.externalCode) { pm.environment.set('lastWorkOrderCode', json.externalCode); }",
                  "pm.test('created', () => pm.response.code === 201);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"woType\": \"DISA\",\n  \"woTypeDescription\": \"Misuratori - Chiusura (sigillo)\",\n  \"tam\": \"DISA\",\n  \"subTam\": \"Disattivazione fornitura\",\n  \"status\": \"RICEVUTO\",\n  \"priorita\": \"Media\",\n  \"appointmentDate\": \"2026-07-10\",\n  \"appointmentStartTime\": \"09:00\",\n  \"appointmentEndTime\": \"09:30\",\n  \"address\": {\n    \"street\": \"VIA TEST\",\n    \"streetNumber\": \"10\",\n    \"city\": \"ANCONA\",\n    \"provincia\": \"AN\",\n    \"additionalInfo\": \"Esterno\"\n  },\n  \"customer\": {\n    \"nome\": \"MARIO\",\n    \"cognome\": \"ROSSI\",\n    \"telefono\": \"3401234567\",\n    \"codBp\": \"90099999\"\n  },\n  \"meter\": {\n    \"matricola\": \"20999999\",\n    \"brand\": \"SENSUS\",\n    \"model\": \"MIS. ACQUA 015 5 CIF\",\n    \"caliber\": \"15\",\n    \"lastReading\": 125.0,\n    \"lastReadingDate\": \"2026-06-15\"\n  },\n  \"accountingSector\": \"POT - Servizio acqua potabile\",\n  \"technicianCID\": \"{{cid}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/work-orders", "host": ["{{baseUrl}}"], "path": ["work-orders"] }
          }
        },
        {
          "name": "Update work-order status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_ESECUZIONE\",\n  \"reason\": null,\n  \"note\": \"Avvio intervento\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/work-orders/{{lastWorkOrderCode}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["work-orders", "{{lastWorkOrderCode}}", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "Avvisi (Notifications)",
      "item": [
        {
          "name": "List notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/notifications?q=",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"],
              "query": [{ "key": "q", "value": "" }]
            }
          }
        },
        {
          "name": "Get notification detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/notifications/{{lastAvvisoNumber}}",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "{{lastAvvisoNumber}}"]
            }
          }
        },
        {
          "name": "Create notification (Avviso)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.numeroAvviso) { pm.environment.set('lastAvvisoNumber', json.numeroAvviso); }",
                  "pm.test('created', () => pm.response.code === 201);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descrizione\": \"Consumo anomalo rilevato — zona residenziale\",\n  \"tipo\": \"PA\",\n  \"categoriaIntervento\": \"MANUTENZIONE\",\n  \"canaleApertura\": \"WEB\",\n  \"tipoServizio\": \"PROGRAMMATO\",\n  \"priorita\": \"Media\",\n  \"stato\": \"Creato\",\n  \"cidAssegnato\": \"{{cid}}\",\n  \"centroLavoro\": \"WC-AN-01\",\n  \"codiceCliente\": \"CLI-80002\",\n  \"referente\": \"Anna Verdi\",\n  \"cellulare\": \"3405556677\",\n  \"dataApertura\": \"2026-07-08\",\n  \"address\": {\n    \"street\": \"VIA FLAMINIA\",\n    \"streetNumber\": \"12\",\n    \"city\": \"ANCONA\",\n    \"provincia\": \"AN\"\n  },\n  \"customer\": {\n    \"nome\": \"Anna\",\n    \"cognome\": \"Verdi\",\n    \"codBp\": \"90080002\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/notifications", "host": ["{{baseUrl}}"], "path": ["notifications"] }
          }
        },
        {
          "name": "Generate work-order from Avviso",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/notifications/{{lastAvvisoNumber}}/generate-work-order",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "{{lastAvvisoNumber}}", "generate-work-order"]
            }
          }
        }
      ]
    },
    {
      "name": "Workflow (Avviso + ODL atomico)",
      "item": [
        {
          "name": "Create Avviso + ODL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.avviso && json.avviso.numeroAvviso) { pm.environment.set('lastAvvisoNumber', json.avviso.numeroAvviso); }",
                  "if (json && json.odl && json.odl.externalCode) { pm.environment.set('lastWorkOrderCode', json.odl.externalCode); }",
                  "pm.test('created', () => pm.response.code === 201);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"avviso\": {\n    \"descrizione\": \"Perdita acqua su strada zona industriale\",\n    \"tipo\": \"ZF-PF\",\n    \"categoriaIntervento\": \"GUASTO\",\n    \"tipoServizio\": \"EMERGENZA\",\n    \"priorita\": \"Alta\",\n    \"stato\": \"Creato\",\n    \"cidAssegnato\": \"{{cid}}\",\n    \"centroLavoro\": \"WC-AN-01\",\n    \"urgente\": true,\n    \"interruzioneFornitura\": true,\n    \"dataApertura\": \"2026-07-08\",\n    \"address\": { \"street\": \"VIA DELLE INDUSTRIE\", \"streetNumber\": \"45\", \"city\": \"ANCONA\", \"provincia\": \"AN\" },\n    \"customer\": { \"ragioneSociale\": \"ACME INDUSTRIE S.R.L.\", \"codBp\": \"90099001\" }\n  },\n  \"odl\": {\n    \"woType\": \"ZA02\",\n    \"woTypeDescription\": \"Riparazione perdita condotta principale\",\n    \"status\": \"RICEVUTO\",\n    \"priorita\": \"Alta\",\n    \"appointmentDate\": \"2026-07-08\",\n    \"appointmentStartTime\": \"14:00\",\n    \"appointmentEndTime\": \"18:00\",\n    \"technicianCID\": \"{{cid}}\",\n    \"accountingSector\": \"POT - Servizio acqua potabile\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workflow/avviso-with-odl",
              "host": ["{{baseUrl}}"],
              "path": ["workflow", "avviso-with-odl"]
            }
          }
        }
      ]
    },
    {
      "name": "Esiti",
      "item": [
        {
          "name": "Submit esito",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workOrderCode\": \"{{lastWorkOrderCode}}\",\n  \"technicianCID\": \"{{cid}}\",\n  \"startDateTime\": \"2026-07-08T09:05:00+02:00\",\n  \"endDateTime\": \"2026-07-08T09:25:00+02:00\",\n  \"result\": \"SUCCESS\",\n  \"causeCode\": \"C004\",\n  \"solutionCode\": \"S004\",\n  \"notes\": \"Disattivazione confermata, sigillo apposto.\",\n  \"meterReadings\": [\n    { \"matricola\": \"20999999\", \"readingValue\": 362, \"readingDateTime\": \"2026-07-08T09:20:00+02:00\" }\n  ],\n  \"hoursWorked\": [{ \"technicianCID\": \"{{cid}}\", \"hours\": 0.33 }]\n}"
            },
            "url": { "raw": "{{baseUrl}}/esiti", "host": ["{{baseUrl}}"], "path": ["esiti"] }
          }
        }
      ]
    },
    {
      "name": "Anagrafiche",
      "item": [
        {
          "name": "Materials",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/anagrafica/materials?q=",
              "host": ["{{baseUrl}}"],
              "path": ["anagrafica", "materials"],
              "query": [{ "key": "q", "value": "" }]
            }
          }
        },
        {
          "name": "Warehouses",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/anagrafica/warehouses", "host": ["{{baseUrl}}"], "path": ["anagrafica", "warehouses"] } }
        },
        {
          "name": "Meter brands",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/anagrafica/meter-brands", "host": ["{{baseUrl}}"], "path": ["anagrafica", "meter-brands"] } }
        },
        {
          "name": "TAM codes",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/anagrafica/tam-codes", "host": ["{{baseUrl}}"], "path": ["anagrafica", "tam-codes"] } }
        },
        {
          "name": "Causes",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/anagrafica/causes", "host": ["{{baseUrl}}"], "path": ["anagrafica", "causes"] } }
        },
        {
          "name": "Solutions",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/anagrafica/solutions", "host": ["{{baseUrl}}"], "path": ["anagrafica", "solutions"] } }
        },
        {
          "name": "Equipment (by matricola)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/anagrafica/equipment?matricola=20114578",
              "host": ["{{baseUrl}}"],
              "path": ["anagrafica", "equipment"],
              "query": [{ "key": "matricola", "value": "20114578" }, { "key": "barcode", "value": "", "disabled": true }]
            }
          }
        },
        {
          "name": "Tecnici (search)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/anagrafica/tecnici?q=",
              "host": ["{{baseUrl}}"],
              "path": ["anagrafica", "tecnici"],
              "query": [{ "key": "q", "value": "" }]
            }
          }
        },
        {
          "name": "Operatori (riassegnazione)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/anagrafica/operatori", "host": ["{{baseUrl}}"], "path": ["anagrafica", "operatori"] } }
        }
      ]
    }
  ]
}
