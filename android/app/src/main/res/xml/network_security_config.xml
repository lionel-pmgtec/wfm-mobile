<?xml version="1.0" encoding="utf-8"?>
<!--
  Restringe il cleartext HTTP ai SOLI host di sviluppo del middleware WFM:
  - 10.0.2.2   : emulatore Android verso l'host
  - localhost  : in caso di test su desktop / web
  - 192.168.*  : dispositivi fisici sulla LAN di sviluppo

  In produzione il middleware è in HTTPS, quindi questa eccezione non è
  necessaria. Per QA/Prod basta NON includere questi domini.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- IP LAN del PC di sviluppo. NB: Android NON fa match per subnet, quindi
             ogni indirizzo del PC va elencato per intero (non basta 192.168.1.0). -->
        <domain includeSubdomains="false">192.168.1.93</domain>
        <domain includeSubdomains="false">192.168.1.71</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
